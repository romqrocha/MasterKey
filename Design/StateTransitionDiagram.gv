digraph {
        Init [label="Locked" shape=circle]
        Hub [label="Unlocked" shape=circle]
        A [label="Asking for account name" shape=circle]
        2 [label="Asking for account email" shape=circle]
        3 [label="Asking for account password" shape=circle]
        OAuth [label="Asking for OAuth provider" shape=circle]
        4 [label="Entering Extra KVP (key)" shape=circle]
        5 [label="Entering Extra KVP (value)" shape=circle]
        Beta [label="Checking Account Info" shape=circle]
        Beta2 [label="Editing KVP Key" shape=circle]
        Beta3 [label="Editing KVP Value" shape=circle]

        Init -> Hub [label=" Unlock"]
        Init -> A [label=" Add new account"]
        Hub -> A [label=" Add new account"]
        A -> 2 [label=" Entered account name"]
        2 -> OAuth [label=" Pressed OAuth key"]
        OAuth -> 4 [label=" Entered OAuth provider"]
        2 -> 3 [label=" Entered email"]
        3 -> 4 [label=" Entered password"]
        4 -> Hub [label= " Entered nothing"]
        4 -> 5 [label= " Entered kvp key"]
        5 -> 4 [label= " Entered kvp value"]
        Hub -> Beta [label=" Retrieve account info"]
        Beta -> Beta2 [label=" Pressed number key"]
        Beta2 -> Beta [label=" Pressed del"]
        Beta2 -> Beta3 [label=" Finished editing key"]
        Beta3 -> Beta [label=" Finished editing value"]
        Beta -> Hub [label=" Pressed del or esc"]
}